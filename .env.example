# --- Site ---
NEXT_PUBLIC_SITE_URL=https://indigo.example.org

# --- Supabase (Dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVEUR UNIQUEMENT. Ne jamais préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anti-abus : chaîne aléatoire longue (openssl rand -hex 32). Sert à hacher les IP. ---
IP_HASH_SALT=

# --- Dons : laisser "false" tant que statut juridique + banque + éligibilité fiscale ne sont pas vérifiés ---
NEXT_PUBLIC_DONATIONS_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Test local uniquement (sans Supabase) : écrit les demandes dans .data/submissions.jsonl. NE PAS activer en production. ---
# LOCAL_SUBMISSIONS_FALLBACK=true
